# Endereço da API. O painel encaminha /api para esse servidor.
# Na Vercel, defina Root Directory como sistema-pontos-web e grave API_URL
# com a URL pública da API (https://SUA-API.vercel.app). Sem barra no final.
# O login do SUAP usa este mesmo site, então o callback cadastrado no SUAP é
# https://SEU-FRONTEND.vercel.app/api/auth/suap/callback
API_URL=http://127.0.0.1:3000

# Opcional. Vale se API_URL não estiver definida.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
